### Server
DATABASE_URL=Driver={ODBC Driver 18 for SQL Server};Server=(localdb)\CoduisZen;Database=CoduisZen;Trusted_Connection=Yes;Encrypt=No;
API_PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth & Security
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_JWT_SECRET
JWT_EXPIRES_IN=12h
AUDIT_HMAC_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_AUDIT_SECRET
PUBLIC_SCREEN_TOKEN=CHANGE_ME_RANDOM_PUBLIC_SCREEN_TOKEN
AI_KEY_ENCRYPTION_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_AI_KEY_SECRET
AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_MAX_IP_ATTEMPTS=40
AUTH_LOGIN_MAX_EMAIL_ATTEMPTS=8
AUTH_LOGIN_BLOCK_MS=900000
AUTH_SESSION_TTL_HOURS=12
AUTH_MFA_ISSUER=RestoFlow ERP
AUTH_MFA_ENFORCE_ADMIN_FINANCE=false
PRINT_GATEWAY_TOKEN=CHANGE_ME_MIN_32_CHARS_PRINT_GATEWAY_TOKEN
SERVER_AUTO_PRINT_RECEIPT=false
OPENROUTER_API_KEY=
WHATSAPP_PROVIDER=disabled
ENABLE_WHATSAPP_WEB=false
WHATSAPP_WEB_CLIENT_ID=restoflow-main
WHATSAPP_HEADLESS=true
WHATSAPP_CHROME_PATH=
WHATSAPP_CHROME_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu
WHATSAPP_TRANSACTIONAL_DELAY_MS=1500
WHATSAPP_MARKETING_MIN_DELAY_MS=8000
WHATSAPP_MARKETING_MAX_DELAY_MS=22000
WHATSAPP_MARKETING_BATCH_SIZE=35
WHATSAPP_MARKETING_BATCH_PAUSE_MS=600000
# Optional external OpenWA gateway. Leave empty when using the internal headless WhatsApp Web engine.
OPENWA_API_URL=http://localhost:2785/api
# Local OpenWA API_MASTER_KEY. Optional if OpenWA API_MASTER_KEY is empty, generated by scripts/setup-openwa-gateway.ps1.
OPENWA_API_KEY=
OPENWA_SESSION_ID=
OPENWA_SESSION_NAME=restoflow-erp
# Optional multi-number routing. Example:
# OPENWA_SESSIONS=[{"name":"orders-main","role":"ORDERS","branchId":"b1","default":true},{"name":"support-main","role":"SUPPORT"},{"name":"marketing-main","role":"MARKETING"},{"name":"feedback-main","role":"FEEDBACK"}]
OPENWA_SESSIONS=
WHATSAPP_AUTOMATION_ENABLED=true
WHATSAPP_FEEDBACK_DELAY_MS=3600000
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM=

# ETA / Fiscal Integration
ETA_BASE_URL=
ETA_TOKEN_URL=
ETA_CLIENT_ID=
ETA_CLIENT_SECRET=
ETA_API_KEY=
ETA_PRIVATE_KEY=
ETA_PRIVATE_KEY_PASSPHRASE=
ETA_RIN=
ETA_COMPANY_NAME=
ETA_BRANCH_CODE=
ETA_COUNTRY=EG
ETA_GOVERNATE=Cairo
ETA_CITY=Cairo
ETA_STREET=
ETA_BUILDING=

# Socket.IO multi-instance scaling (optional)
SOCKET_REDIS_ENABLED=false
SOCKET_REDIS_URL=redis://localhost:6379

# Day close email delivery (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# S3 / Object Storage (optional for image uploads)
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

### Client
VITE_API_URL=/api
# Optional explicit Socket endpoint. Leave empty to use same origin.
VITE_SOCKET_URL=

# Maps for delivery address pinning and driver navigation.
# Vite injects these at frontend build time. Set before npm build / Docker build.
# Use osm for a free/self-hostable stack. Use google only for clients who provide a paid Google key.
VITE_MAPS_PROVIDER=osm
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org
VITE_GOOGLE_MAPS_API_KEY=
VITE_DEFAULT_MAP_LAT=30.0444
VITE_DEFAULT_MAP_LNG=31.2357

# AI key is server-side only (do not expose in VITE_* envs)
# Optional local AI fallback via Ollama (no cloud daily limits)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Firebase (optional)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
