# Server
DATABASE_URL=Driver={ODBC Driver 18 for SQL Server};Server=<server>;Database=<database>;UID=<user>;PWD=<password>;Encrypt=Yes;TrustServerCertificate=No;
API_PORT=3001
CORS_ORIGINS=https://erp.example.com,https://admin.example.com
GO_LIVE_REQUIRE_STRICT_CORS=true
GO_LIVE_REQUIRE_ETA=true
GO_LIVE_REQUIRE_SMTP=true
GO_LIVE_REQUIRE_S3=false

# Auth & Security
JWT_SECRET=<generate-strong-random-secret>
PIN_LOOKUP_SECRET=<generate-strong-random-pin-lookup-secret>
TRACK_TOKEN_SECRET=<generate-strong-random-public-tracking-secret>
PUBLIC_QR_SECRET=<generate-strong-random-table-qr-secret>
PUBLIC_ORDER_BASE_URL=https://your-public-order-host.example
PAYMENT_TOKEN_SECRET=<generate-strong-random-payment-token-secret>
PAYMENT_TOKEN_SECRET_PREVIOUS=
JWT_EXPIRES_IN=12h
AUDIT_HMAC_SECRET=<generate-strong-random-secret>
AUDIT_HMAC_SECRET_PREVIOUS=
AUDIT_HMAC_KEY_VERSION=1
CODUIS_MASTER_KEY=<generate-strong-random-setup-secret>
PUBLIC_SCREEN_TOKEN=<generate-strong-random-screen-token>
AI_KEY_ENCRYPTION_SECRET=<generate-strong-random-secret>
AI_KEY_ENCRYPTION_SECRET_PREVIOUS=
PRINT_GATEWAY_TOKEN=<strong-random-print-gateway-token>
PRINT_GATEWAY_REQUIRE_PER_GATEWAY_TOKENS=true
PRINT_GATEWAY_TOKENS=<json-map-of-gateway-ids-to-strong-secrets>
ATTENDANCE_BRIDGE_TOKEN=<strong-random-attendance-bridge-token>
# Optional public integration API. Store SHA-256 hashes only, never raw keys.
PUBLIC_API_KEYS_JSON=
OPENROUTER_API_KEY=<server-default-openrouter-key>
GEMINI_API_KEY=<optional-server-default-gemini-key>
NVIDIA_API_KEY=<optional-server-default-nvidia-key>
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
AI_ALLOWED_PROVIDER_HOSTS=<comma-separated-approved-hosts-for-openai-compatible-provider>
WHATSAPP_PROVIDER=meta
WHATSAPP_WEBHOOK_VERIFY_TOKEN=<whatsapp-webhook-verify-token>
WHATSAPP_WEBHOOK_SECRET=<openwa-webhook-secret>
WHATSAPP_META_APP_SECRET=<meta-app-secret>
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM=

# ETA / Fiscal Integration (Egypt)
ETA_BASE_URL=
ETA_TOKEN_URL=
ETA_CLIENT_ID=
ETA_CLIENT_SECRET=
ETA_API_KEY=
ETA_PRIVATE_KEY=
ETA_PRIVATE_KEY_PASSPHRASE=
ETA_RIN=
ETA_COMPANY_NAME=
ETA_BRANCH_CODE=
ETA_COUNTRY=EG
ETA_GOVERNATE=Cairo
ETA_CITY=Cairo
ETA_STREET=
ETA_BUILDING=

# Socket.IO multi-instance scaling
SOCKET_REDIS_ENABLED=true
SOCKET_REDIS_URL=redis://<redis-host>:6379

# Day close email delivery (SMTP)
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
SMTP_FROM=reports@example.com

# S3 / Object Storage (optional)
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# Client
VITE_API_URL=/api
VITE_SOCKET_URL=

# AI key is server-side only (do not expose in VITE_* envs)
# Optional local AI fallback via Ollama (recommended for unlimited internal usage)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Optional Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Shared secret required by ZKTeco ADMS push devices (x-adms-secret or Bearer).
ADMS_WEBHOOK_SECRET=
# Optional: make /api/health perform a short non-mutating Paymob auth probe.
ENABLE_INTEGRATION_HEALTH_PROBES=false
