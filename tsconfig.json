{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "App.tsx",
    "routes.tsx",
    "types.ts",
    "types/**/*.d.ts",
    "index.tsx",
    "vite-env.d.ts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "services/**/*.ts",
    "services/**/*.tsx",
    "stores/**/*.ts",
    "stores/**/*.tsx",
    "utils/**/*.ts",
    "utils/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "server/**/*.ts",
    "server/**/*.tsx",
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "theme/**/*.ts",
    "theme/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "db/**/*.ts",
    "drizzle.config.ts",
    "vitest*.ts",
    "hardware-bridge/**/*.ts",
    "hardware-bridge/**/*.tsx",
    "hardware-bridge/**/*.js"
  ],
  "exclude": [
    "manual-seed.ts",
    "Ashraf System",
    "node_modules",
    "node_modules_old",
    "dist",
    "dist-server",
    "coverage",
    "drizzle",
    "artifacts",
    "client-release",
    "client-delivery/openwa-gateway",
    "attendance-bridge",
    "CoduisZenAttendanceBridge-Branches",
    "scratch",
    ".wwebjs_auth",
    ".wwebjs_cache",
    "vite.config.ts.timestamp-*.mjs",
    ".ua",
    "tmp",
    "output",
    "prototypes",
    "backups",
    "RestoFlow-HotFix-*",
    "One Click Builder"
  ]
}
